{
  "name": "personalcrm-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "lint": "tsc -b --noEmit",
    "test:e2e": "playwright test",
    "check:ru": "rg -n \"\\\"[^\\\"]*\\b(Save|Cancel|Search|Create|Delete|Edit|Contact|Project)s?\\b[^\\\"]*\\\"|'[^']*\\b(Save|Cancel|Search|Create|Delete|Edit|Contact|Project)s?\\b[^']*'\" src && exit 1 || exit 0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}

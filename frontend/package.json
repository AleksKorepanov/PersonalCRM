{
  "name": "personalcrm-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "lint": "tsc -b --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "PWDEBUG=1 playwright test --project=chromium",
    "test:e2e:report": "playwright show-report",
    "check:ru": "rg -n \"\\\"[^\\\"]*\\b(Save|Cancel|Search|Create|Delete|Edit|Contact|Project|Reminder|Interaction|Introduction|Week|Panel|Status|Done|Close|Open|Settings|Update|Remove|Add|Send|Copy|Success|Error|Info|Loading|Retry|Owner|Assistant|Role|Filter|Import|Export|Follow-up)s?\\b[^\\\"]*\\\"|'[^']*\\b(Save|Cancel|Search|Create|Delete|Edit|Contact|Project|Reminder|Interaction|Introduction|Week|Panel|Status|Done|Close|Open|Settings|Update|Remove|Add|Send|Copy|Success|Error|Info|Loading|Retry|Owner|Assistant|Role|Filter|Import|Export|Follow-up)s?\\b[^']*'\" src | rg -v \"X-Debug-Role|data-testid|dataTestId\" && exit 1 || exit 0"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}

# -------------------------------
# Backend
# -------------------------------
APP_ENV=local
APP_DEBUG=1

# In dev we allow auth bypass. Set to 0 to enforce JWT.
AUTH_DISABLED=1
DEV_USER_EMAIL=owner@local.dev

# JWT (only used when AUTH_DISABLED=0)
JWT_ISSUER=personalcrm
JWT_AUDIENCE=personalcrm
JWT_SECRET=change-me
JWT_ALG=HS256

# Postgres
POSTGRES_DB=personalcrm
POSTGRES_USER=personalcrm
POSTGRES_PASSWORD=personalcrm
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
DATABASE_URL=postgresql+psycopg://personalcrm:personalcrm@postgres:5432/personalcrm

# Frontend
VITE_API_BASE_URL=http://localhost:8000
